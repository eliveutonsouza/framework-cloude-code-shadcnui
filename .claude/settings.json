{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npx skills *)",
      "Bash(npx tsc *)",
      "Bash(git *)",
      "Bash(supabase *)"
    ]
  },
  "hooks": {
    "TaskCompleted": [
      {
        "type": "command",
        "command": "npx tsc --noEmit"
      }
    ]
  }
}
